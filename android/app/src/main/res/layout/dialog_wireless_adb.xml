<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wadb_instructions"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/vsTextSecondary" />

    <EditText
        android:id="@+id/wadb_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/wadb_host"
        android:inputType="text" />

    <EditText
        android:id="@+id/wadb_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/wadb_port"
        android:inputType="number" />

    <EditText
        android:id="@+id/wadb_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/wadb_code"
        android:inputType="number"
        android:maxLength="6" />

    <TextView
        android:id="@+id/wadb_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/vsTextSecondary" />
</LinearLayout>
